 


  
  

  Vidya Dental Care & Implant Centre | Dentist in Haldwani
  
  

  
  
  

  
    :root {
      --primary: #123f3d;
      --primary-light: #1c5753;
      --accent: #e98b68;
      --accent-dark: #d87450;
      --mint: #dff1eb;
      --mint-light: #eef8f4;
      --cream: #fbf9f5;
      --white: #ffffff;
      --text: #18302f;
      --muted: #637573;
      --border: #dce7e3;
      --shadow: 0 20px 60px rgba(18, 63, 61, 0.11);
      --radius: 24px;
      --container: 1160px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      font-family: "DM Sans", sans-serif;
      color: var(--text);
      background: var(--white);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    body.menu-open {
      overflow: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input, 
    select,
    textarea {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    img,
    svg {
      display: block;
      max-width: 100%;
    }

    .container {
      width: min(var(--container), calc(100% - 40px));
      margin-inline: auto;
    }

    .section {
      padding: 96px 0;
    }

    .section-soft {
      background: var(--cream);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 16px;
      color: var(--primary-light);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 2px;
      background: var(--accent);
    }

    h1,
    h2,
    h3 {
      font-family: "Manrope", sans-serif;
      line-height: 1.16;
      letter-spacing: -0.035em;
    }

    h1 {
      max-width: 680px;
      font-size: clamp(2.7rem, 5.7vw, 5rem);
      font-weight: 800;
    }

    h2 {
      font-size: clamp(2rem, 4vw, 3.25rem);
      font-weight: 800;
    }

    h3 {
      font-size: 1.2rem;
      font-weight: 700;
    }

    .section-heading {
      max-width: 720px;
      margin-bottom: 48px;
    }

    .section-heading p {
      margin-top: 18px;
      color: var(--muted);
      font-size: 1.05rem;
    }

    .button {
      display: inline-flex;
      min-height: 52px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 23px;
      border: 1px solid transparent;
      border-radius: 999px;
      background: var(--primary);
      color: var(--white);
      font-weight: 700;
      cursor: pointer;
      transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
    }

    .button:hover {
      transform: translateY(-2px);
      background: var(--primary-light);
      box-shadow: 0 10px 25px rgba(18, 63, 61, 0.16);
    }

    .button-accent {
      background: var(--accent);
      color: #281610;
    }

    .button-accent:hover {
      background: var(--accent-dark);
      color: var(--white);
    }

    .button-outline {
      border-color: var(--border);
      background: transparent;
      color: var(--primary);
    }

    .button-outline:hover {
      background: var(--mint-light);
      color: var(--primary);
    }

    .button svg {
      width: 19px;
      height: 19px;
    }

    .skip-link {
      position: fixed;
      top: 10px;
      left: 10px;
      z-index: 200;
      padding: 10px 16px;
      border-radius: 8px;
      background: var(--white);
      color: var(--primary);
      transform: translateY(-150%);
    }

    .skip-link:focus {
      transform: translateY(0);
    }

    /* Header */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid rgba(220, 231, 227, 0.8);
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(16px);
    }

    .header-inner {
      display: flex;
      min-height: 78px;
      align-items: center; 
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      flex-shrink: 0;
    }

    .brand-mark {
      display: grid;
      width: 43px;
      height: 43px;
      place-items: center;
      border-radius: 14px;
      background: var(--primary);
      color: var(--white);
    }

    .brand-mark svg {
      width: 25px;
    }

    .brand-name {
      font-family: "Manrope", sans-serif;
      font-size: 1rem;
      font-weight: 800;
      line-height: 1.2;
    }

    .brand-name small {
      display: block;
      margin-top: 3px;
      color: var(--muted);
      font-family: "DM Sans", sans-serif;
      font-size: 0.69rem;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 27px;
      color: #405653;
      font-size: 0.92rem;
      font-weight: 600;
    }

    .desktop-nav a:not(.button):hover {
      color: var(--accent-dark);
    }

    .desktop-nav .button {
      min-height: 44px;
      padding: 10px 19px;
      color: var(--white);
    }

    .menu-toggle {
      display: none;
      width: 44px;
      height: 44px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--white);
      color: var(--primary);
      cursor: pointer;
    }

    .mobile-nav {
      display: none;
    }

    /* Hero */
    .hero { 
      position: relative;
      overflow: hidden;
      padding: 78px 0 84px;
      background: 
        radial-gradient(circle at 88% 12%, rgba(223, 241, 235, 0.9), transparent 33%),
        linear-gradient(180deg, #fff 0%, #fbfdfc 100%);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 64px;
    }

    .hero h1 span {
      color: var(--primary-light);
    }

    .hero-description {
      max-width: 610px;
      margin-top: 23px;
      color: var(--muted);
      font-size: 1.12rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
      margin-top: 32px;
    }

    .hero-proof {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-top: 29px;
      color: var(--muted);
      font-size: 0.91rem;
    }

    .rating-pill {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 13px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--white);
      color: var(--primary);
      font-weight: 700;
    }

    .stars {
      color: #e6a137;
      letter-spacing: 1px;
    }

    .hero-art {
      position: relative;
      display: grid;
      min-height: 490px;
      place-items: center;
      border-radius: 42% 42% 28px 28px;
      background: linear-gradient(145deg, #d8eee6, #eff8f3);
      isolation: isolate;
    }

    .hero-art::before,
    .hero-art::after {
      content: "";
      position: absolute;
      z-index: -1;
      border-radius: 50%;
    }

    .hero-art::before {
      width: 290px;
      height: 290px;
      background: rgba(255, 255, 255, 0.48);
    }

    .hero-art::after {
      right: -34px;
      bottom: 35px;
      width: 110px;
      height: 110px;
      border: 22px solid rgba(233, 139, 104, 0.24);
    }

    .tooth-illustration {
      width: 230px;
      filter: drop-shadow(0 24px 24px rgba(18, 63, 61, 0.13));
    }

    .art-card {
      position: absolute;
      padding: 16px 19px;
      border: 1px solid rgba(255, 255, 255, 0.85);
      border-radius: 17px;
      background: rgba(255, 255, 255, 0.93);
      box-shadow: var(--shadow);
      backdrop-filter: blur(10px);
    }

    .art-card strong {
      display: block;
      font-family: "Manrope", sans-serif;
      font-size: 0.97rem;
    }

    .art-card span {
      color: var(--muted);
      font-size: 0.8rem;
    }

    .art-card-top {
      top: 44px;
      right: -19px;
    }

    .art-card-bottom {
      bottom: 45px;
      left: -28px;
    }

    .art-card-bottom strong {
      color: var(--primary);
      font-size: 1.45rem;
    }

    /* Trust strip */
    .trust-strip {
      border-block: 1px solid var(--border);
      background: var(--white);
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .trust-item {
      padding: 28px 32px;
      text-align: center;
    }

    .trust-item + .trust-item {
      border-left: 1px solid var(--border);
    }

    .trust-item strong {
      display: block;
      margin-bottom: 4px;
      font-family: "Manrope", sans-serif;
      color: var(--primary);
    }

    .trust-item span {
      color: var(--muted);
      font-size: 0.9rem;
    }

    /* Services */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .service-card {
      position: relative;
      min-height: 245px;
      padding: 30px;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--white);
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .service-card:hover {
      transform: translateY(-5px);
      border-color: #bad6cc;
      box-shadow: var(--shadow);
    }

    .service-number {
      display: inline-grid;
      width: 45px;
      height: 45px;
      margin-bottom: 26px;
      place-items: center;
      border-radius: 14px;
      background: var(--mint-light);
      color: var(--primary);
      font-family: "Manrope", sans-serif;
      font-size: 0.8rem;
      font-weight: 800;
    }

    .service-card p {
      margin-top: 12px;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .service-card-featured {
      background: var(--primary);
      color: var(--white);
    }

    .service-card-featured .service-number {
      background: rgba(255, 255, 255, 0.12);
      color: var(--white);
    }

    .service-card-featured p {
      color: #d6e5e1;
    }

    .treatment-note {
      max-width: 850px;
      margin-top: 28px;
      color: var(--muted);
      font-size: 0.87rem;
    }

    /* Experience */
    .experience-grid {
      display: grid;
      grid-template-columns: 0.88fr 1.12fr;
      align-items: center;
      gap: 74px;
    }

    .doctor-panel {
      position: relative;
      min-height: 450px;
      padding: 42px;
      overflow: hidden;
      border-radius: 32px;
      background: var(--primary);
      color: var(--white);
    }

    .doctor-panel::after {
      content: "";
      position: absolute;
      right: -90px;
      bottom: -100px;
      width: 300px;
      height: 300px;
      border: 55px solid rgba(255, 255, 255, 0.07);
      border-radius: 50%;
    }

    .doctor-initial {
      display: grid;
      width: 104px;
      height: 104px;
      margin-bottom: 80px;
      place-items: center;
      border-radius: 30px;
      background: var(--mint);
      color: var(--primary);
      font-family: "Manrope", sans-serif;
      font-size: 2.1rem;
      font-weight: 800;
    }

    .doctor-panel small {
      color: #b8d7ce;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .doctor-panel h3 {
      max-width: 320px;
      margin-top: 11px;
      font-size: 2rem;
    }

    .doctor-panel p {
      margin-top: 12px;
      color: #d4e5e0;
    }

    .experience-content > p {
      margin-top: 20px;
      color: var(--muted);
      font-size: 1.04rem;
    }

    .experience-list {
      display: grid;
      gap: 17px;
      margin-top: 28px;
      list-style: none;
    }

    .experience-list li {
      display: flex;
      align-items: flex-start;
      gap: 13px;
    }

    .check {
      display: grid;
      width: 25px; 
      height: 25px;
      flex: 0 0 25px;
      margin-top: 2px;
      place-items: center;
      border-radius: 50%;
      background: var(--mint);
      color: var(--primary);
      font-weight: 800;
    }

    /* Process */
    .process-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      counter-reset: process;
    }

    .process-card {
      position: relative;
      padding: 30px 0 0;
      border-top: 1px solid var(--border);
      counter-increment: process;
    }

    .process-card::before {
      content: "0" counter(process);
      display: block;
      margin-bottom: 21px;
      color: var(--accent-dark);
      font-family: "Manrope", sans-serif;
      font-size: 0.85rem;
      font-weight: 800;
    }

    .process-card p {
      margin-top: 11px;
      color: var(--muted);
    }

    /* Reviews */
    .reviews-header {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 45px;
    }

    .reviews-header .section-heading {
      margin-bottom: 0;
    }

    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .review-card {
      display: flex;
      min-height: 310px;
      flex-direction: column;
      padding: 29px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--white);
    }

    .review-card .stars {
      margin-bottom: 21px;
      font-size: 0.9rem;
    }

    .review-card blockquote {
      flex: 1;
      color: #405653;
      font-size: 0.98rem;
    }

    .review-card footer {
      margin-top: 24px;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 600;
    }

    .review-disclaimer {
      margin-top: 25px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    /* Contact */
    .contact-section {
      padding: 96px 0;
      background: var(--primary);
      color: var(--white);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 70px;
    }

    .contact-section .eyebrow {
      color: var(--mint);
    }

    .contact-section .section-heading p {
      color: #c6dad5;
    }

    .contact-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .contact-actions .button-outline {
      border-color: rgba(255, 255, 255, 0.3);
      color: var(--white);
    }

    .contact-actions .button-outline:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .contact-details {
      display: grid;
      gap: 1px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.12);
    }

    .contact-item {
      padding: 25px 27px;
      background: #194946;
    }

    .contact-item small {
      display: block;
      margin-bottom: 7px;
      color: #a9cbc2;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .contact-item p,
    .contact-item a {
      color: var(--white);
    }

    .contact-item a:hover {
      text-decoration: underline;
    }

    /* FAQ */
    .faq-wrap {
      max-width: 850px;
      margin-inline: auto;
    }

    .faq-item {
      border-bottom: 1px solid var(--border);
    }

    .faq-item summary {
      position: relative;
      padding: 23px 42px 23px 0;
      font-family: "Manrope", sans-serif;
      font-weight: 700;
      cursor: pointer;
      list-style: none;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary::after {
      content: "+";
      position: absolute;
      top: 20px;
      right: 5px;
      color: var(--primary);
      font-size: 1.5rem;
      font-weight: 400;
    }

    .faq-item[open] summary::after {
      content: "−";
    }

    .faq-item p {
      padding: 0 35px 23px 0;
      color: var(--muted);
    }

    /* Footer */
    .site-footer {
      padding: 32px 0;
      background: #0c302e;
      color: #bad1cc;
      font-size: 0.85rem;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .footer-inner strong {
      color: var(--white);
    }

    .footer-note {
      max-width: 560px;
      text-align: right;
    }

    /* Appointment dialog */
    .appointment-dialog {
      width: min(570px, calc(100% - 28px));
      max-height: 90vh;
      padding: 0;
      overflow: auto;
      border: 0;
      border-radius: 26px;
      background: var(--white);
      color: var(--text);
      box-shadow: 0 30px 100px rgba(0, 0, 0, 0.25);
    }

    .appointment-dialog::backdrop {
      background: rgba(8, 32, 31, 0.7);
      backdrop-filter: blur(5px);
    }

    .dialog-content {
      padding: 32px;
    }

    .dialog-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
    }

    .dialog-top h2 {
      font-size: 1.75rem;
    }

    .dialog-top p {
      margin-top: 8px;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .dialog-close {
      display: grid;
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      place-items: center;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: var(--white);
      color: var(--primary);
      font-size: 1.4rem;
      cursor: pointer;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 17px;
    }

    .form-field {
      display: grid;
      gap: 7px;
    }

    .form-field-full {
      grid-column: 1 / -1;
    }

    .form-field label {
      font-size: 0.85rem;
      font-weight: 700;
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 11px;
      outline: none;
      background: #fcfdfd;
      color: var(--text);
    }

    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
      border-color: var(--primary-light);
      box-shadow: 0 0 0 3px rgba(28, 87, 83, 0.1);
    }

    .form-field textarea {
      min-height: 90px;
      resize: vertical;
    }

    .form-submit {
      width: 100%;
      margin-top: 22px;
    }

    .form-note {
      margin-top: 13px;
      color: var(--muted);
      font-size: 0.76rem;
      text-align: center;
    }

    .mobile-call {
      display: none;
    }

    :focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 4px;
    }

    @media (max-width: 980px) {
      .desktop-nav {
        display: none;
      }

      .menu-toggle {
        display: grid;
        place-items: center;
      }

      .mobile-nav {
        position: fixed;
        top: 78px;
        right: 0;
        left: 0;
        z-index: 99;
        padding: 20px;
        border-bottom: 1px solid var(--border);
        background: var(--white);
        box-shadow: var(--shadow);
      }

      .mobile-nav.open {
        display: grid;
        gap: 5px;
      }

      .mobile-nav a {
        padding: 12px 10px;
        font-weight: 600;
      }

      .mobile-nav .button {
        margin-top: 8px;
      }

      .hero-grid, 
      .experience-grid,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .hero-grid {
        gap: 50px;
      }

      .hero-art {
        width: min(520px, 100%);
        min-height: 420px;
        margin-inline: auto;
      }

      .services-grid,
      .reviews-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .experience-grid,
      .contact-grid {
        gap: 45px;
      }

      .doctor-panel {
        min-height: auto;
      }

      .doctor-initial {
        margin-bottom: 55px;
      }
    }

    @media (max-width: 680px) {
      .container {
        width: min(100% - 30px, var(--container));
      }

      .section, 
      .contact-section {
        padding: 70px 0;
      }

      .hero {
        padding: 52px 0 60px;
      }

      h1 {
        font-size: clamp(2.45rem, 12vw, 3.6rem);
      }

      .hero-description {
        font-size: 1rem;
      }

      .hero-actions .button {
        width: 100%;
      }

      .hero-art {
        min-height: 360px;
        border-radius: 35% 35% 24px 24px;
      }

      .tooth-illustration {
        width: 180px;
      }

      .art-card-top {
        top: 24px;
        right: 10px;
      }

      .art-card-bottom {
        bottom: 25px;
        left: 10px;
      }

      .trust-grid,
      .services-grid,
      .process-grid,
      .reviews-grid {
        grid-template-columns: 1fr;
      }

      .trust-item {
        padding: 20px;
      }

      .trust-item + .trust-item {
        border-top: 1px solid var(--border);
        border-left: 0;
      } 

      .service-card {
        min-height: auto;
      }

      .doctor-panel {
        padding: 30px;
      }

      .reviews-header {
        display: block;
      }

      .reviews-header .button {
        margin-top: 24px;
      }

      .review-card {
        min-height: auto;
      }

      .footer-inner {
        align-items: flex-start;
        flex-direction: column;
      }

      .footer-note {
        text-align: left;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-field-full {
        grid-column: auto;
      }

      .dialog-content {
        padding: 24px;
      }

      .mobile-call {
        position: fixed;
        right: 16px;
        bottom: 16px;
        z-index: 80;
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 999px;
        background: var(--accent);
        color: #281610;
        box-shadow: 0 10px 35px rgba(18, 63, 61, 0.25);
        font-weight: 800;
      }

      .site-footer {
        padding-bottom: 90px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        transition: none !important;
      }
    }
  




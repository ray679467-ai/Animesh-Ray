<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Local Shop — Fresh Finds, Best Prices</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- EmailJS (free, client-side email sending) -->
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

<style>
  /* ============ DESIGN TOKENS ============ */
  :root{
    --forest:#1F3D2B;
    --forest-deep:#152B1E;
    --marigold:#E8A83A;
    --marigold-deep:#C98A1F;
    --paper:#FBF6EC;
    --paper-dim:#F1E9D8;
    --ink:#22221F;
    --ink-soft:#5B5B52;
    --rust:#C1502E;
    --line:rgba(34,34,31,0.12);
    --radius:14px;
    --shadow:0 10px 30px rgba(21,43,30,0.16);
    --font-display:'Fraunces', serif;
    --font-body:'Inter', sans-serif;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:var(--font-body);
    background:var(--paper);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  button{font-family:inherit;cursor:pointer;}
  a{color:inherit;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }

  /* ============ TOP BAR ============ */
  .topbar{
    position:sticky; top:0; z-index:40;
    background:var(--forest);
    color:var(--paper);
    padding:14px 20px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .brand{
    display:flex; align-items:center; gap:10px;
    font-family:var(--font-display);
    font-weight:700; font-size:1.3rem;
    letter-spacing:0.2px;
  }
  .brand-mark{
    width:34px;height:34px;border-radius:50%;
    background:var(--marigold);
    display:flex;align-items:center;justify-content:center;
    color:var(--forest-deep); font-size:1.1rem; font-weight:700;
    font-family:var(--font-display);
  }
  .topbar-tag{
    font-size:0.78rem; color:var(--paper-dim); opacity:0.85;
    display:none;
  }
  @media(min-width:600px){ .topbar-tag{display:block;} }

  /* ============ HERO ============ */
  .hero{
    position:relative;
    min-height:78vh;
    display:flex; align-items:flex-end;
    background:#111;
    overflow:hidden;
  }
  .hero img{
    position:absolute; inset:0;
    width:100%; height:100%; object-fit:cover;
    object-position:center 30%;
    opacity:0.88;
  }
  .hero::after{
    content:"";
    position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(21,43,30,0.15) 0%, rgba(21,43,30,0.35) 55%, rgba(15,26,18,0.92) 100%);
  }
  .hero-content{
    position:relative; z-index:2;
    padding:60px 24px 56px;
    max-width:720px;
    color:var(--paper);
  }
  .hero-eyebrow{
    display:inline-block;
    font-size:0.8rem; letter-spacing:0.14em; text-transform:uppercase;
    background:rgba(232,168,58,0.16);
    border:1px solid rgba(232,168,58,0.5);
    color:var(--marigold);
    padding:6px 14px; border-radius:999px;
    margin-bottom:18px;
    font-weight:600;
  }
  .hero h1{
    font-family:var(--font-display);
    font-size:clamp(2.4rem, 6vw, 4.2rem);
    line-height:1.04;
    margin:0 0 14px;
    font-weight:700;
  }
  .hero h1 em{
    color:var(--marigold);
    font-style:italic;
  }
  .hero p{
    font-size:1.05rem;
    color:var(--paper-dim);
    max-width:480px;
    margin:0 0 30px;
  }
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    border:none; border-radius:999px;
    padding:15px 30px;
    font-weight:700; font-size:1rem;
    background:var(--marigold);
    color:var(--forest-deep);
    box-shadow:0 8px 22px rgba(232,168,58,0.35);
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .btn:hover{ transform:translateY(-2px); box-shadow:0 12px 26px rgba(232,168,58,0.45); }
  .btn:active{ transform:translateY(0); }
  .btn-ghost{
    background:transparent;
    color:var(--paper);
    border:1.5px solid rgba(251,246,236,0.5);
    box-shadow:none;
  }

  /* ============ SECTION SHELL ============ */
  .section{
    padding:70px 20px;
    max-width:1180px;
    margin:0 auto;
  }
  .section-head{
    display:flex; align-items:flex-end; justify-content:space-between;
    gap:20px;
    margin-bottom:34px;
    flex-wrap:wrap;
  }
  .section-eyebrow{
    font-size:0.78rem; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--rust); font-weight:700;
    margin:0 0 8px;
  }
  .section-head h2{
    font-family:var(--font-display);
    font-size:clamp(1.8rem, 3.4vw, 2.6rem);
    margin:0;
    color:var(--forest-deep);
  }
  .section-sub{
    color:var(--ink-soft);
    max-width:420px;
    font-size:0.96rem;
    margin:0;
  }

  /* ============ CAROUSEL ============ */
  .carousel-wrap{ position:relative; }
  .carousel{
    display:flex;
    gap:20px;
    overflow-x:auto;
    scroll-snap-type:x mandatory;
    padding:6px 6px 22px;
    scrollbar-width:thin;
    scrollbar-color:var(--marigold) transparent;
  }
  .carousel::-webkit-scrollbar{ height:8px; }
  .carousel::-webkit-scrollbar-thumb{ background:var(--marigold); border-radius:8px; }
  .carousel::-webkit-scrollbar-track{ background:var(--paper-dim); border-radius:8px; }

  .card{
    flex:0 0 auto;
    width:250px;
    scroll-snap-align:start;
    background:#fff;
    border-radius:var(--radius);
    border:1px solid var(--line);
    box-shadow:var(--shadow);
    overflow:hidden;
    position:relative;
    display:flex; flex-direction:column;
  }
  .card-img{
    width:100%; height:210px; object-fit:cover;
    background:var(--paper-dim);
  }
  .card-body{
    padding:16px 16px 18px;
    display:flex; flex-direction:column; gap:10px;
    flex:1;
  }
  .card-name{
    font-family:var(--font-display);
    font-weight:600; font-size:1.08rem;
    margin:0;
    color:var(--ink);
  }
  .card-foot{
    margin-top:auto;
    display:flex; align-items:center; justify-content:space-between;
    gap:10px;
  }
  /* signature element: hand-tagged price sticker */
  .price-tag{
    position:relative;
    background:var(--forest);
    color:var(--paper);
    font-family:var(--font-display);
    font-weight:700;
    font-size:1rem;
    padding:6px 14px 6px 20px;
    border-radius:3px 10px 10px 3px;
    transform:rotate(-2deg);
    white-space:nowrap;
  }
  .price-tag::before{
    content:"";
    position:absolute; left:8px; top:50%;
    width:6px; height:6px;
    background:var(--paper);
    border-radius:50%;
    transform:translateY(-50%);
  }
  .price-tag::after{
    content:"";
    position:absolute; left:-9px; top:50%;
    width:12px; height:1.5px;
    background:var(--ink-soft);
    transform:translateY(-50%) rotate(8deg);
  }
  .add-btn{
    background:var(--marigold-deep);
    color:#fff;
    border:none; border-radius:999px;
    padding:9px 16px;
    font-weight:700; font-size:0.85rem;
    display:flex; align-items:center; gap:6px;
    transition:background .15s ease, transform .15s ease;
  }
  .add-btn:hover{ background:var(--forest); }
  .add-btn.added{ background:var(--forest); }

  .carousel-nav{
    display:flex; gap:10px; justify-content:center; margin-top:6px;
  }
  .nav-btn{
    width:40px; height:40px; border-radius:50%;
    border:1px solid var(--line);
    background:#fff;
    display:flex; align-items:center; justify-content:center;
    font-size:1.1rem;
    color:var(--forest-deep);
    box-shadow:0 4px 10px rgba(0,0,0,0.06);
  }
  .nav-btn:hover{ background:var(--marigold); color:var(--forest-deep); border-color:var(--marigold); }

  /* ============ ABOUT STRIP ============ */
  .strip{
    background:var(--forest);
    color:var(--paper);
    padding:44px 20px;
  }
  .strip-inner{
    max-width:1180px; margin:0 auto;
    display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:24px;
    text-align:center;
  }
  .strip-item h3{
    font-family:var(--font-display);
    color:var(--marigold);
    font-size:1.6rem;
    margin:0 0 4px;
  }
  .strip-item p{
    margin:0; font-size:0.88rem; color:var(--paper-dim);
  }

  /* ============ FOOTER ============ */
  footer{
    background:var(--forest-deep);
    color:var(--paper-dim);
    padding:36px 20px 90px;
    text-align:center;
    font-size:0.86rem;
  }
  footer a{ color:var(--marigold); text-decoration:none; }

  /* ============ FLOATING BUTTONS ============ */
  .floating-stack{
    position:fixed; right:18px; bottom:18px; z-index:60;
    display:flex; flex-direction:column; gap:14px; align-items:flex-end;
  }
  .fab{
    width:58px; height:58px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 10px 24px rgba(0,0,0,0.25);
    border:none;
    position:relative;
  }
  .fab-cart{
    background:var(--marigold);
    color:var(--forest-deep);
    font-size:1.5rem;
  }
  .fab-cart .badge{
    position:absolute; top:-4px; right:-4px;
    background:var(--rust);
    color:#fff;
    min-width:22px; height:22px;
    border-radius:50%;
    font-size:0.72rem; font-weight:700;
    display:flex; align-items:center; justify-content:center;
    border:2px solid var(--paper);
    padding:0 3px;
  }
  .fab-wa{
    background:#25D366;
    color:#fff;
    font-size:1.6rem;
  }

  /* ============ CART DRAWER ============ */
  .overlay{
    position:fixed; inset:0; background:rgba(21,43,30,0.5);
    opacity:0; pointer-events:none; transition:opacity .25s ease;
    z-index:70;
  }
  .overlay.open{ opacity:1; pointer-events:auto; }

  .drawer{
    position:fixed; top:0; right:0; bottom:0;
    width:min(420px, 100%);
    background:var(--paper);
    z-index:80;
    transform:translateX(100%);
    transition:transform .3s ease;
    display:flex; flex-direction:column;
    box-shadow:-10px 0 30px rgba(0,0,0,0.2);
  }
  .drawer.open{ transform:translateX(0); }
  .drawer-head{
    background:var(--forest);
    color:var(--paper);
    padding:20px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .drawer-head h3{
    font-family:var(--font-display);
    margin:0; font-size:1.3rem;
  }
  .drawer-close{
    background:transparent; border:none; color:var(--paper);
    font-size:1.4rem; line-height:1;
  }
  .drawer-body{
    flex:1; overflow-y:auto; padding:18px 20px;
  }
  .cart-empty{
    text-align:center; color:var(--ink-soft); padding:40px 10px;
  }
  .cart-item{
    display:flex; gap:12px; align-items:center;
    padding:12px 0; border-bottom:1px solid var(--line);
  }
  .cart-item img{
    width:60px; height:60px; object-fit:cover; border-radius:8px;
    flex-shrink:0;
  }
  .cart-item-info{ flex:1; min-width:0; }
  .cart-item-info .n{ font-weight:600; font-size:0.94rem; margin:0 0 2px; }
  .cart-item-info .p{ color:var(--ink-soft); font-size:0.85rem; margin:0; }
  .qty-ctl{
    display:flex; align-items:center; gap:8px;
  }
  .qty-ctl button{
    width:26px; height:26px; border-radius:50%;
    border:1px solid var(--line); background:#fff;
    font-weight:700; font-size:0.9rem;
  }
  .remove-btn{
    background:transparent; border:none; color:var(--rust);
    font-size:1.2rem; padding:4px 6px;
  }
  .cart-total{
    display:flex; justify-content:space-between;
    font-family:var(--font-display); font-weight:700; font-size:1.15rem;
    padding:16px 0 6px;
    color:var(--forest-deep);
  }

  .order-form{
    padding:18px 20px 26px;
    border-top:1px solid var(--line);
    background:var(--paper-dim);
  }
  .order-form h4{
    font-family:var(--font-display);
    margin:0 0 12px; font-size:1.05rem; color:var(--forest-deep);
  }
  .field{ margin-bottom:12px; }
  .field label{
    display:block; font-size:0.8rem; font-weight:600; color:var(--ink-soft);
    margin-bottom:5px;
  }
  .field input{
    width:100%; padding:11px 12px;
    border:1px solid var(--line); border-radius:8px;
    font-size:0.95rem; background:#fff;
    font-family:inherit;
  }
  .field input:focus{ outline:2px solid var(--marigold); outline-offset:1px; }
  .send-btn{
    width:100%; background:var(--forest);
    color:#fff; border:none; border-radius:999px;
    padding:14px; font-weight:700; font-size:1rem;
    margin-top:4px;
  }
  .send-btn:hover{ background:var(--forest-deep); }
  .send-btn[disabled]{ opacity:0.6; cursor:not-allowed; }
  .form-msg{
    font-size:0.85rem; margin-top:10px; text-align:center;
  }
  .form-msg.ok{ color:var(--forest); font-weight:600; }
  .form-msg.err{ color:var(--rust); font-weight:600; }

  .visually-hidden{
    position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap;
  }

  :focus-visible{ outline:3px solid var(--marigold); outline-offset:2px; }
</style>
</head>
<body>

<!-- ============ TOP BAR ============ -->
<header class="topbar">
  <div class="brand">
    <span class="brand-mark">TL</span>
    The Local Shop
  </div>
  <span class="topbar-tag">Fresh Finds, Best Prices</span>
</header>

<!-- ============ HERO ============ -->
<section class="hero">
  <img src="https://i.ibb.co/YFnh8TrB/happy-beautiful-couple-posing-with-shopping-bags-violet.jpg" alt="Happy customers carrying shopping bags after visiting The Local Shop">
  <div class="hero-content">
    <span class="hero-eyebrow">Right around the corner</span>
    <h1>Fresh finds, <em>best prices</em>, every single day.</h1>
    <p>The Local Shop brings you handpicked everyday essentials at prices your neighbourhood deserves. Come browse, or shop right here.</p>
    <a href="#products" class="btn">Shop Now ↓</a>
  </div>
</section>

<!-- ============ PRODUCTS ============ -->
<section class="section" id="products">
  <div class="section-head">
    <div>
      <p class="section-eyebrow">This week's picks</p>
      <h2>Fresh off the shelf</h2>
    </div>
    <p class="section-sub">Scroll sideways to browse, or use the arrows. Tap "Add to Cart" to build your order.</p>
  </div>

  <div class="carousel-wrap">
    <div class="carousel" id="carousel"></div>
    <div class="carousel-nav">
      <button class="nav-btn" id="prevBtn" aria-label="Scroll products left">←</button>
      <button class="nav-btn" id="nextBtn" aria-label="Scroll products right">→</button>
    </div>
  </div>
</section>

<!-- ============ ABOUT STRIP ============ -->
<section class="strip">
  <div class="strip-inner">
    <div class="strip-item"><h3>100%</h3><p>Locally sourced picks</p></div>
    <div class="strip-item"><h3>Same-day</h3><p>Order &amp; pickup or delivery</p></div>
    <div class="strip-item"><h3>Every day</h3><p>Fresh stock, fair prices</p></div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer id="contact">
  <p><strong>The Local Shop</strong> — Fresh Finds, Best Prices</p>
  <p>Questions? Email us at <a href="mailto:ray679467@gmail.com">ray679467@gmail.com</a></p>
  <p>&copy; <span id="year"></span> The Local Shop. All rights reserved.</p>
</footer>

<!-- ============ FLOATING BUTTONS ============ -->
<div class="floating-stack">
  <button class="fab fab-cart" id="cartFab" aria-label="Open cart">
    🛒
    <span class="badge" id="cartBadge" hidden>0</span>
  </button>
  <a class="fab fab-wa" id="waFab" href="https://wa.me/10000000000" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    💬
  </a>
</div>

<!-- ============ CART DRAWER ============ -->
<div class="overlay" id="overlay"></div>
<aside class="drawer" id="drawer" aria-label="Shopping cart">
  <div class="drawer-head">
    <h3>Your Cart</h3>
    <button class="drawer-close" id="closeDrawer" aria-label="Close cart">✕</button>
  </div>

  <div class="drawer-body" id="cartItems">
    <!-- filled by JS -->
  </div>

  <form class="order-form" id="orderForm">
    <h4>Complete your order</h4>
    <div class="field">
      <label for="custName">Your name</label>
      <input type="text" id="custName" name="custName" placeholder="e.g. Priya Sharma" required>
    </div>
    <div class="field">
      <label for="custPhone">Phone number</label>
      <input type="tel" id="custPhone" name="custPhone" placeholder="e.g. 98765 43210" required>
    </div>
    <div class="field">
      <label for="cartTotalField">Order total</label>
      <div class="cart-total" style="padding:0; font-size:1rem;"><span>Total</span><span id="totalDisplay">₹0</span></div>
    </div>
    <button type="submit" class="send-btn" id="sendBtn">Send Order</button>
    <p class="form-msg" id="formMsg"></p>
  </form>
</aside>

<script>
document.getElementById('year').textContent = new Date().getFullYear();

/* ==========================================================
   CONFIG — replace with your own values before going live
   ========================================================== */
const CONFIG = {
  ownerEmail: "ray679467@gmail.com",
  whatsappNumber: "10000000000",     // replace with real number, digits only, country code first
  emailjs: {
    publicKey:  "YOUR_EMAILJS_PUBLIC_KEY",
    serviceId:  "YOUR_EMAILJS_SERVICE_ID",
    templateId: "YOUR_EMAILJS_TEMPLATE_ID"
  }
};

if (window.emailjs && CONFIG.emailjs.publicKey !== "YOUR_EMAILJS_PUBLIC_KEY") {
  emailjs.init({ publicKey: CONFIG.emailjs.publicKey });
}

document.getElementById('waFab').href = "https://wa.me/" + CONFIG.whatsappNumber;

/* ==========================================================
   PRODUCT DATA — edit names/prices as needed
   ========================================================== */
const PRODUCTS = [
  {
    id: "p1",
    name: "Everyday Essentials Pack",
    price: 249,
    img: "https://i.ibb.co/5hLs4x7G/Screenshot-2026-08-26-113922.png"
  },
  {
    id: "p2",
    name: "Fresh Pantry Bundle",
    price: 399,
    img: "https://i.ibb.co/WNDPvTMv/Screenshot-2026-08-26-114402.png"
  },
  {
    id: "p3",
    name: "Weekly Household Combo",
    price: 549,
    img: "https://i.ibb.co/JwhPcJ6n/Screenshot-2026-08-26-114430.png"
  }
];

/* ==========================================================
   RENDER PRODUCT CAROUSEL
   ========================================================== */
const carouselEl = document.getElementById('carousel');

function renderProducts(){
  carouselEl.innerHTML = PRODUCTS.map(p => `
    <article class="card">
      <img class="card-img" src="${p.img}" alt="${p.name}" loading="lazy">
      <div class="card-body">
        <p class="card-name">${p.name}</p>
        <div class="card-foot">
          <span class="price-tag">₹${p.price}</span>
          <button class="add-btn" data-id="${p.id}">+ Add to Cart</button>
        </div>
      </div>
    </article>
  `).join('');

  carouselEl.querySelectorAll('.add-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      addToCart(btn.dataset.id);
      btn.classList.add('added');
      btn.textContent = 'Added ✓';
      setTimeout(() => {
        btn.classList.remove('added');
        btn.textContent = '+ Add to Cart';
      }, 900);
    });
  });
}
renderProducts();

document.getElementById('prevBtn').addEventListener('click', () => {
  carouselEl.scrollBy({ left: -280, behavior: 'smooth' });
});
document.getElementById('nextBtn').addEventListener('click', () => {
  carouselEl.scrollBy({ left: 280, behavior: 'smooth' });
});

/* ==========================================================
   CART LOGIC
   ========================================================== */
let cart = {}; // { productId: qty }

function addToCart(id){
  cart[id] = (cart[id] || 0) + 1;
  renderCart();
  openDrawer();
}

function changeQty(id, delta){
  if (!cart[id]) return;
  cart[id] += delta;
  if (cart[id] <= 0) delete cart[id];
  renderCart();
}

function removeFromCart(id){
  delete cart[id];
  renderCart();
}

function cartCount(){
  return Object.values(cart).reduce((a,b) => a+b, 0);
}

function cartTotal(){
  return Object.entries(cart).reduce((sum, [id, qty]) => {
    const p = PRODUCTS.find(x => x.id === id);
    return sum + (p ? p.price * qty : 0);
  }, 0);
}

const cartItemsEl = document.getElementById('cartItems');
const cartBadge = document.getElementById('cartBadge');
const totalDisplay = document.getElementById('totalDisplay');

function renderCart(){
  const ids = Object.keys(cart);
  const count = cartCount();

  cartBadge.textContent = count;
  cartBadge.hidden = count === 0;
  totalDisplay.textContent = '₹' + cartTotal();

  if (ids.length === 0){
    cartItemsEl.innerHTML = `<div class="cart-empty">Your cart is empty.<br>Add something tasty from the shelf 👆</div>`;
    return;
  }

  cartItemsEl.innerHTML = ids.map(id => {
    const p = PRODUCTS.find(x => x.id === id);
    const qty = cart[id];
    return `
      <div class="cart-item">
        <img src="${p.img}" alt="${p.name}">
        <div class="cart-item-info">
          <p class="n">${p.name}</p>
          <p class="p">₹${p.price} × ${qty} = ₹${p.price * qty}</p>
        </div>
        <div class="qty-ctl">
          <button type="button" data-act="minus" data-id="${id}" aria-label="Decrease quantity">−</button>
          <span>${qty}</span>
          <button type="button" data-act="plus" data-id="${id}" aria-label="Increase quantity">+</button>
        </div>
        <button type="button" class="remove-btn" data-act="remove" data-id="${id}" aria-label="Remove item">🗑</button>
      </div>
    `;
  }).join('');

  cartItemsEl.querySelectorAll('button[data-act]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      const act = btn.dataset.act;
      if (act === 'plus') changeQty(id, 1);
      if (act === 'minus') changeQty(id, -1);
      if (act === 'remove') removeFromCart(id);
    });
  });
}
renderCart();

/* ==========================================================
   DRAWER OPEN / CLOSE
   ========================================================== */
const drawer = document.getElementById('drawer');
const overlay = document.getElementById('overlay');

function openDrawer(){
  drawer.classList.add('open');
  overlay.classList.add('open');
}
function closeDrawer(){
  drawer.classList.remove('open');
  overlay.classList.remove('open');
}

document.getElementById('cartFab').addEventListener('click', openDrawer);
document.getElementById('closeDrawer').addEventListener('click', closeDrawer);
overlay.addEventListener('click', closeDrawer);

/* ==========================================================
   SEND ORDER — EmailJS
   ========================================================== */
const orderForm = document.getElementById('orderForm');
const sendBtn = document.getElementById('sendBtn');
const formMsg = document.getElementById('formMsg');

orderForm.addEventListener('submit', function(e){
  e.preventDefault();
  formMsg.textContent = '';
  formMsg.className = 'form-msg';

  if (cartCount() === 0){
    formMsg.textContent = 'Your cart is empty — add a product first.';
    formMsg.classList.add('err');
    return;
  }

  const name = document.getElementById('custName').value.trim();
  const phone = document.getElementById('custPhone').value.trim();

  if (!name || !phone){
    formMsg.textContent = 'Please fill in your name and phone number.';
    formMsg.classList.add('err');
    return;
  }

  const itemsList = Object.entries(cart).map(([id, qty]) => {
    const p = PRODUCTS.find(x => x.id === id);
    return `${p.name} × ${qty} — ₹${p.price * qty}`;
  }).join('\n');

  const templateParams = {
    to_email: CONFIG.ownerEmail,
    customer_name: name,
    customer_phone: phone,
    order_items: itemsList,
    order_total: '₹' + cartTotal()
  };

  if (!window.emailjs || CONFIG.emailjs.publicKey === "YOUR_EMAILJS_PUBLIC_KEY"){
    formMsg.textContent = 'EmailJS isn\'t configured yet — add your Service ID, Template ID and Public Key in the CONFIG section of the script.';
    formMsg.classList.add('err');
    console.log('Order that would have been sent:', templateParams);
    return;
  }

  sendBtn.disabled = true;
  sendBtn.textContent = 'Sending...';

  emailjs.send(CONFIG.emailjs.serviceId, CONFIG.emailjs.templateId, templateParams)
    .then(() => {
      formMsg.textContent = 'Order sent! We\'ll reach out to confirm shortly.';
      formMsg.classList.add('ok');
      cart = {};
      renderCart();
      orderForm.reset();
    })
    .catch((err) => {
      console.error('EmailJS error:', err);
      formMsg.textContent = 'Something went wrong sending your order. Please try again or WhatsApp us.';
      formMsg.classList.add('err');
    })
    .finally(() => {
      sendBtn.disabled = false;
      sendBtn.textContent = 'Send Order';
    });
});
</script>

